supabase/.temp/

# NOTE: the generated *.xcodeproj IS committed on purpose. Xcode Cloud runs the
# committed post-clone script to reconstruct Config/Secrets.xcconfig.
# project.yml is the source of truth; regenerate the project with
# `xcodegen generate` after adding files, then commit the result.
# Package.resolved is also committed for reproducible dependency versions.
.claude/worktrees/
