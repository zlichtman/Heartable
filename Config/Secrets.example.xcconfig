// Copy to Config/Secrets.xcconfig (gitignored) and fill in. These are surfaced into
// Info.plist as $(KEY) and read at runtime via AppConfig.
//
// NOTE: xcconfig treats `//` as a comment, so the Supabase URL is stored as a
// bare host (no https://). AppConfig prepends the scheme. Audius + Deezer need
// no credentials. Last.fm is optional (stats sidecar).

SUPABASE_HOST = ghmuafydukliccwamkrq.supabase.co
SUPABASE_ANON_KEY =
SPOTIFY_CLIENT_ID =
LASTFM_API_KEY =
LASTFM_USER =
