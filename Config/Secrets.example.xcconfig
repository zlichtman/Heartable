// Optional overrides. Copy to Config/Secrets.xcconfig (gitignored) to point the
// app at a different Supabase project or Spotify app; the public defaults are
// built into AppConfig. Values reach the app through Info.plist as $(KEY).
//
// xcconfig treats `//` as a comment, so the Supabase URL is a bare host
// (no https://); AppConfig adds the scheme.

SUPABASE_HOST = ghmuafydukliccwamkrq.supabase.co
SUPABASE_ANON_KEY =
